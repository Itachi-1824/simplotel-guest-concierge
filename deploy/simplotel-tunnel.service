[Unit]
Description=Simplotel HTTPS tunnel
After=network-online.target simplotel-web.service
Wants=network-online.target

[Service]
Type=simple
User=simplotel
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel run --token-file /srv/simplotel/tunnel.token
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
